# ============================================================
# CHANG SUEK RUN 2027 — ตัวแปรสภาพแวดล้อม (คัดลอกเป็น .env แล้วกรอก)
# ============================================================

# --- แอดมิน (จำเป็น) ---------------------------------------
ADMIN_USERNAME=admin
# อย่างน้อย 10 ตัวอักษร ถ้าไม่ตั้ง ระบบจะสุ่มรหัสใหม่ทุกครั้งที่เปิดเซิร์ฟเวอร์ และพิมพ์ไว้ใน log
ADMIN_PASSWORD=
# สตริงสุ่มยาว ๆ ใช้เซ็น token ล็อกอิน (ถ้าไม่ตั้ง แอดมินต้องล็อกอินใหม่ทุกครั้งที่รีสตาร์ท)
ADMIN_SESSION_SECRET=

# --- ที่เก็บข้อมูล (สำคัญมาก) ----------------------------------
# โฟลเดอร์เก็บคำสั่งซื้อและรูปสลิป ต้องเป็นพื้นที่ถาวร ไม่หายเมื่อรีสตาร์ท
DATA_DIR=./data

# --- บัญชีรับเงิน (แก้ภายหลังได้ในหน้าแอดมิน) ----------------------
PROMPTPAY_ID=0818902027
PROMPTPAY_ACCOUNT_NAME=โครงการวิ่งช้างศึกรัน (ศูนย์ฝึกสุนัขตำรวจ ค่ายพระรามหก)
# ชื่อเจ้าของบัญชีตามที่ธนาคารแสดงบนสลิป คั่นด้วยจุลภาค (ใช้ตรวจว่าโอนเข้าบัญชีถูกต้อง)
PROMPTPAY_RECEIVER_NAMES=

# --- ตรวจสลิปอัตโนมัติกับธนาคาร (เลือก 1 อย่าง ไม่บังคับ) ------------
# ถ้าไม่ตั้ง สลิปทุกใบจะเข้าคิวให้แอดมินตรวจและอนุมัติเอง
EASYSLIP_API_KEY=
THUNDER_API_KEY=
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# --- Omise PromptPay (ไม่บังคับ — ยืนยันการจ่ายอัตโนมัติ ไม่ต้องแนบสลิป) --
# ใช้ได้กับยอด 20 บาทขึ้นไป ตั้ง Webhook ใน Omise Dashboard เป็น https://<โดเมน>/api/payment-webhook
OMISE_SECRET_KEY=

# --- Gemini (ไม่บังคับ — ช่วยอ่านสลิปให้แอดมินดูประกอบเท่านั้น) -------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
